# ==========================================
# TurnosYa - Variables de Entorno (Plantilla)
# ==========================================
# IMPORTANTE: Copia este archivo como .env.local y completa con los valores
# de tu proyecto en Supabase (Settings -> API).
# NUNCA uses la service_role key en el frontend.

# URL del proyecto Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Clave pública/anónima del cliente (Anon Public Key / Publishable Key)
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
